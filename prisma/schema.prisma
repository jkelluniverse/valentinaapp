generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PRACTITIONER
  CLIENT
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String?
  role         Role       @default(CLIENT)
  active       Boolean    @default(true) // deactivation gate for login
  locale       String     @default("en") // AMD-05 — UI chrome + client-facing AI + email ("en" | "es")
  sessionVersion Int      @default(0) // AMD-05 B2 — stamped into the JWT; bump revokes all sessions
  notifyPrefs  Json? // AMD-05 — per-kind email prefs (e.g. {"booking":true,"messages":true,"quietStart":22,"quietEnd":7})
  consentAt    DateTime? // legacy account consent (kept for back-compat; AMENDMENT-01)
  aiConsentAt  DateTime? // legacy AI-review opt-in — folded into unified consent (AMENDMENT-01)
  consentGrants ConsentGrant[]
  emailChanges EmailChangeRequest[]
  deletionRequests DeletionRequest[]
  entries      LogEntry[]
  assignments  Assignment[]  @relation("ClientAssignments")
  record       RecordItem[]  @relation("ClientRecord")
  preps        SessionPrep[] @relation("ClientPreps")
  enrollments  Enrollment[]  @relation("ClientEnrollments")
  worksheets   WorksheetAssignment[] @relation("ClientWorksheets")
  appointments Appointment[] @relation("ClientAppointments")
  profile      ClientProfile?
  humanDesign  HumanDesignChart?
  birthCore    BirthChartCore?
  lensResults  LensResult[]  @relation("ClientLenses")
  integrativeProfile IntegrativeProfile?
  integrativeReading IntegrativeReading?
  conversation Conversation? @relation("ClientConversation")
  notes        Note[]        @relation("ClientNotes")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// AMENDMENT-01 — Unified Consent. One versioned global grant covers the whole
// portal scope (storage, practitioner review, AI-assisted processing, charts,
// messages-as-record). lib/consent.ts is the single gate; a version bump is the
// only thing that ever re-asks. Card-on-file and session recording stay
// separate in-context opt-ins and are NOT represented here.
model ConsentGrant {
  id        String   @id @default(cuid())
  userId    String
  version   String // e.g. "2026-07"
  grantedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
}

// AMD-05 B2 — verified email change. The address switches ONLY when the link
// sent to the NEW address is confirmed; the old address is notified on request
// (account-takeover tripwire). Tokens stored hashed, single-use, expiring.
model EmailChangeRequest {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail   String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// AMD-05 B3 — "request deletion" is a REQUEST, not a self-serve nuke: it opens
// a flagged task for the practitioner and gets honored on a defined timeline.
model DeletionRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  note        String?
  status      String    @default("OPEN") // OPEN | ACKNOWLEDGED | CLOSED
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
}

// C17 — The Deepening. After a reflection is kept, an async safety-first pass
// may offer ONE gentle, optional "door" to go a little further. Answers become
// record items (feeding C16) and self-map stars. A skip is signal, never a nag;
// crisis suppresses deepening and flags Valentina. No entry content is logged.
model EntryDeepening {
  id                 String    @id @default(cuid())
  entryId            String    @unique // one deepening per kept entry
  clientId           String
  door               String? // somatic | recurrence | belief | temporal | origin | protection | resource | connection
  question           String?
  pacing             String    @default("settled") // settled | tender | raw | crisis
  routeToSession     Boolean   @default(false) // significant material → hand to the room
  groundingNote      String? // shown when raw/flooded instead of a probe
  connectionItemId   String? // an echo to the client's OWN earlier record item
  connectionLine     String?
  answer             String? // the client's answer (if they walk through the door)
  answeredNodeId     String? // SELF_REPORTED node the answer became
  dismissed          Boolean   @default(false)
  crisis             Boolean   @default(false)
  crisisCleared      Boolean   @default(false)
  createdAt          DateTime  @default(now())
  answeredAt         DateTime?

  @@index([clientId, createdAt])
}

// C16 — The Constellation: the visual psyche map. PRACTITIONER-ONLY (the
// app's most sensitive artifact); every AI node/edge carries evidence links to
// the client's actual record items; language is experiential, never diagnostic.
enum NodeKind {
  WOUND
  SHADOW
  CORE_BELIEF
  PROTECTION
  PATTERN
  BEHAVIOR
  TRAIT
  RESOURCE
  GIFT
}

enum NodeSource {
  AI_EXTRACTED
  PRACTITIONER
  SELF_REPORTED
}

enum NodeState {
  ACTIVE
  LOOSENING
  INTEGRATED
  ARCHIVED
}

model PsycheNode {
  id                    String     @id @default(cuid())
  clientId              String
  kind                  NodeKind
  label                 String // short, human ("Not enough as I am")
  description           String? // one paragraph, plain language
  source                NodeSource
  state                 NodeState  @default(ACTIVE)
  weight                Float      @default(1) // computed from evidence count/recency — drives size
  evidenceRecordItemIds String[] // every node traces to the client's actual material
  chartRefs             Json? // optional resonance: gate/key/center/stage this echoes
  giftLabel             String? // the Gene Keys-style transmutation target ("Sovereign worth")
  suggestedState        NodeState? // AI-suggested transition, Valentina-confirmed (§5)
  suggestedReason       String?
  selfX                 Float? // the client's own star placement (Your First Map)
  selfY                 Float?
  promptKey             String? // which First Map prompt birthed a self-reported node
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([clientId, kind, state])
}

model PsycheEdge {
  id                    String   @id @default(cuid())
  clientId              String
  fromId                String // e.g. the wound
  toId                  String // e.g. the protection it drives
  relation              String // DRIVES | PROTECTS_FROM | EXPRESSES_AS | ROOTED_IN | REINFORCES | SOFTENED_BY
  weight                Float    @default(1)
  evidenceRecordItemIds String[]
  createdAt             DateTime @default(now())

  @@unique([fromId, toId, relation])
  @@index([clientId])
}

// Metadata-only audit of extraction runs (C5-grade handling).
model PsycheExtraction {
  id            String    @id @default(cuid())
  clientId      String
  requestedById String
  deep          Boolean   @default(false) // full-record re-read vs incremental
  scopeFrom     DateTime?
  scopeTo       DateTime
  model         String
  nodesCreated  Int       @default(0)
  nodesUpdated  Int       @default(0)
  edgesCreated  Int       @default(0)
  referralFlag  Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([clientId, createdAt])
}

// Every curation action Valentina takes on a map, audited.
model PsycheAudit {
  id        String   @id @default(cuid())
  clientId  String
  actorId   String
  action    String // ADD_NODE | EDIT_NODE | SET_STATE | MERGE | ARCHIVE | ADD_EDGE | DELETE_EDGE | TO_NOTE
  detail    String
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

// C16.8 — the Pattern Library: the practice ontology. NO client references, by
// design — the schema cannot hold client content, IDs, or text from records.
model PatternArchetype {
  id          String   @id @default(cuid())
  kind        NodeKind
  label       String   @unique // "Not-enoughness"
  definition  String
  clientCount Int      @default(0) // k-floored (k >= 5) before any use
  updatedAt   DateTime @updatedAt
}

model PatternLink {
  id          String @id @default(cuid())
  fromId      String
  toId        String
  relation    String
  strength    Float // aggregate, k-floored
  clientCount Int

  @@unique([fromId, toId, relation])
}

// AMENDMENT-03 — The Library, as Folders. Folders nest without limit; items are
// POINTERS to existing C9 worksheets / C3 prompts / C6 courses (refId), or
// storage-free docs (body) and links (url). Deleting moves to trash (deletedAt),
// never silent loss.
model LibraryFolder {
  id             String   @id @default(cuid())
  practitionerId String
  name           String
  parentId       String? // null = top level; nesting unlimited
  isDefault      Boolean  @default(false) // the seeded four (renameable, not deletable)
  order          Int      @default(0)
  deletedAt      DateTime? // trashed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([practitionerId, parentId, order])
}

model LibraryItem {
  id        String   @id @default(cuid())
  folderId  String
  kind      String // WORKSHEET | PROMPT | COURSE | FILE | LINK | DOC
  refId     String? // points at the C9 Worksheet / C3 Prompt / C6 Course (no duplication)
  fileKey   String? // object-storage key for uploads (when storage is configured)
  url       String? // LINK target
  body      String? // DOC text content
  name      String
  order     Int      @default(0)
  deletedAt DateTime? // trashed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folderId, order])
}

// C11 — client profile. DOB, birth time, and birthplace are sensitive PII:
// stored to the app's high standard, never logged, and (with the in-house HD
// engine) never sent to any external service — only the place NAME goes to a
// geocoder, with no identity or date attached.
model ClientProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredName    String?
  pronouns         String?
  phone            String?
  // birth data (drives Human Design)
  birthDate        DateTime? // civil date, stored midnight UTC
  birthTime        String? // "HH:MM" local; exact if known
  birthTimeUnknown Boolean   @default(false)
  birthTimePrecision String? // AMD-05 B5.3 — EXACT | APPROXIMATE | UNKNOWN (null = legacy, derive from birthTimeUnknown)
  paymentRemindersMuted Boolean @default(false) // C13-PKG §9 — per-client auto-reminder mute
  renewalMessagesMuted  Boolean @default(false) // C13-PKG §6 — suppress the automatic client renewal message
  birthPlace       String? // as entered by the client
  birthLat         Float? // geocoded
  birthLng         Float?
  birthTz          String? // IANA tz for that place (historical rules applied by tz db)
  intakeCompletedAt DateTime?
  firstMapCompletedAt DateTime? // C16.5 — "Your First Map" self-mapping exercise
  stage            String? // current program stage (C13); history in StageChange
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// The generated Human Design chart. Computed fully in-house (astronomy-engine
// ephemeris + HD mechanics) — provider records engine + version for audit;
// raw keeps the full computation so a provider switch needs no schema change.
model HumanDesignChart {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String
  type         String?
  strategy     String?
  authority    String?
  profile      String? // e.g. "1/3"
  definition   String?
  centers      Json? // { centerName: "defined" | "open" }
  channels     Json? // active channel list
  gates        Json? // personality/design activations
  variables    Json?
  bodygraphSvg String? // reserved: the app renders from `centers`/`channels` live
  raw          Json?
  inputHash    String? // hash of birth inputs → detect change → regenerate
  generatedAt  DateTime @default(now())
  accuracyNote String? // set when birth time was estimated
}

// C12 — the Integrative Profile Engine. One birth-data computation (the core)
// feeds every birth-data lens; assessment lenses plug in beside them; the
// synthesis on top is Valentina's method — elicited from her, never invented.

model BirthChartCore {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  personality      Json // 13 gate/line activations at birth
  design           Json // activations at 88° solar arc before birth
  incarnationCross String? // the four cross gates, e.g. "12/11 · 36/6"
  spheres          Json? // Gene Keys sphere positions derived from the core
  provider         String // engine + version (audit)
  inputHash        String
  computedAt       DateTime @default(now())
}

model LensResult {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation("ClientLenses", fields: [userId], references: [id], onDelete: Cascade)
  lens                 String // HUMAN_DESIGN | GENE_KEYS | SPIRAL
  sourceType           String // BIRTH_DATA | ASSESSMENT
  result               Json // structured interpretation for this lens
  contentRef           String? // content version (original-voice / licensed)
  practitionerReviewed Boolean  @default(false) // assessment lenses need her sign-off
  generatedAt          DateTime @default(now())

  @@unique([userId, lens])
}

model IntegrativeProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  synthesis   Json // cross-lens map (structured, per her method)
  narrative   String? // AI-drafted integrative summary — practitioner-facing
  version     String // method + prompt version (audit)
  generatedAt DateTime @default(now())
}

// C12 reading addendum — "What It All Means to You". The ONE client-facing AI
// output. Generated from the three CHARTS ONLY (HD + Gene Keys + Spiral) —
// never the private record. A reflective reading of their design, not a
// formulation of their blocks (which stays practitioner-only, C5).
model IntegrativeReading {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content              String // the reading (markdown)
  model                String // model + prompt version (audit)
  inputHash            String // hash of the 3 charts → detect change → regenerate
  status               String   @default("PUBLISHED") // PUBLISHED | PENDING_REVIEW
  editedByPractitioner Boolean  @default(false)
  generatedAt          DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Small practice-wide key/value settings (e.g. her synthesis-method text).
model PracticeSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// C14 — The Margins. Valentina's private notes: her thinking, NEVER client-
// visible and never written to the C4 record. A jot and a note are the same
// row at different depths. The strictest boundary in the app — every read is
// practitioner-scoped and no note content ever reaches logs.

enum NoteDepth {
  JOT
  NOTE
}

enum NoteStatus {
  OPEN
  ELABORATED
  ARCHIVED
}

model Note {
  id                  String     @id @default(cuid())
  authorId            String // practitioner (always)
  clientId            String? // null = free-floating idea (unfiled notebook)
  client              User?      @relation("ClientNotes", fields: [clientId], references: [id], onDelete: Cascade)
  appointmentId       String? // optional link to a session (C10)
  depth               NoteDepth  @default(JOT)
  status              NoteStatus @default(OPEN)
  title               String?
  body                String
  tags                String[] // theme/belief areas (same vocabulary as client themes)
  linkedRecordItemIds String[] // record items she tied this to (C4)
  parentNoteId        String? // a note elaborated FROM another (thread)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  scans               NoteScan[]

  @@index([clientId, createdAt])
  @@index([authorId, depth, status])
}

model NoteScan {
  id           String   @id @default(cuid())
  noteId       String
  note         Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  model        String
  connections  Json // [{ area, link, evidenceRecordItemIds[], suggestion, confidence }]
  referralFlag Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([noteId, createdAt])
}

// C15 — The Open Line. One calm async 1:1 thread per client. Message content is
// among the most sensitive data in the app: practitioner-scoped reads, never in
// logs, consent governs record-feeding. Client messages (unless off-record)
// become RecordItem(MESSAGE) and feed the psyche net; hers are context only.

enum SenderRole {
  PRACTITIONER
  CLIENT
}

enum ConvoStatus {
  ACTIVE
  PAUSED
}

model Conversation {
  id             String      @id @default(cuid())
  clientId       String      @unique // single practitioner: one thread per client
  client         User        @relation("ClientConversation", fields: [clientId], references: [id], onDelete: Cascade)
  practitionerId String
  status         ConvoStatus @default(ACTIVE)
  lastMessageAt  DateTime?
  createdAt      DateTime    @default(now())
  messages       Message[]
}

model Message {
  id                 String       @id @default(cuid())
  conversationId     String
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId           String
  senderRole         SenderRole
  body               String
  references         Json? // [{ type, id }] — ASSIGNMENT|WORKSHEET|COURSE|LESSON|READING|REFLECTION
  excludedFromRecord Boolean      @default(false) // the "just between us" toggle
  safetyFlag         Boolean      @default(false) // crisis signal detected on a client message
  safetyCleared      Boolean      @default(false) // practitioner acknowledged the flag
  deliveredAt        DateTime?
  readAt             DateTime?
  deletedAt          DateTime? // soft delete (audited)
  createdAt          DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// C13 — program stages, billing ledger, and the Square rail. The app owns the
// ledger and dashboard; Square owns moving money. Card data NEVER touches this
// server (Web Payments SDK tokenizes in the browser); money actions carry an
// actor id; logs stay metadata-only.

model StageChange {
  id          String   @id @default(cuid())
  clientId    String
  fromStage   String?
  toStage     String
  changedById String // practitioner
  note        String?
  changedAt   DateTime @default(now())

  @@index([clientId, changedAt])
}

enum ChargeStatus {
  DUE
  PENDING
  PAID
  REFUNDED
  WAIVED
  CANCELED
  COVERED // C13-PKG — covered by a package credit; no money due for this session
}

// C13-PACKAGES — session packages with an append-only credit ledger. Counters
// are DERIVED, never stored: used = CONSUMED, reserved = RESERVED,
// available = sessionsTotal − used − reserved. The ledger decides.
enum PackageStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  REFUNDED
}

enum CreditState {
  RESERVED
  CONSUMED
  RELEASED
}

model Package {
  id                  String        @id @default(cuid())
  clientId            String
  priceBookId         String // the 3/6/9 SKU
  sessionsTotal       Int
  status              PackageStatus @default(ACTIVE)
  chargeId            String        @unique // the payment that bought it
  purchasedAt         DateTime      @default(now())
  expiresAt           DateTime? // policy — hers (C13-PKG §12)
  lastSessionNoticeAt DateTime? // "next session is her last" notice sent (dedup)
  completedNoticeAt   DateTime? // completion notices sent (dedup)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  credits             SessionCredit[]

  @@index([clientId, status])
}

model SessionCredit {
  id            String      @id @default(cuid())
  packageId     String
  package       Package     @relation(fields: [packageId], references: [id], onDelete: Cascade)
  appointmentId String      @unique // the session it covers
  state         CreditState @default(RESERVED)
  reservedAt    DateTime    @default(now())
  consumedAt    DateTime?
  releasedAt    DateTime?
  reason        String? // COMPLETED | LATE_CANCEL | NO_SHOW | MANUAL | CANCELLED
  actorId       String? // who caused the transition (attributable)

  @@index([packageId, state])
}

model PriceBook {
  id               String  @id @default(cuid())
  name             String // "Standard session", "Stage-2 rate"
  amountCents      Int
  currency         String  @default("USD")
  stage            String? // optional stage-specific rate
  kind             String  @default("SESSION") // SESSION | PACKAGE
  sessionsIncluded Int? // for packages (fast-follow; columns ship now)
  active           Boolean @default(true)
  createdAt        DateTime @default(now())
}

model Charge {
  id              String       @id @default(cuid())
  clientId        String
  appointmentId   String? // the session it bills (null for custom/package charges)
  kind            String       @default("SESSION") // SESSION | PACKAGE | LATE_FEE | CUSTOM
  packageId       String? // C13-PKG — the package that covered this session
  priceBookId     String?
  description     String
  amountCents     Int
  currency        String       @default("USD")
  status          ChargeStatus @default(DUE)
  dueAt           DateTime?
  paidAt          DateTime?
  paidVia         String? // "portal-card" | "in-person" | "square-external" | "waived"
  feeReason       String? // C10-POLICY — LATE_RESCHEDULE | LATE_CANCEL | NO_SHOW
  lastRemindedAt  DateTime? // C13-PKG §9 — no accidental double-nudging
  remindCount     Int          @default(0) // auto-reminders: dueAt, +7d, stop
  squarePaymentId String?      @unique
  squareInvoiceId String?      @unique
  lastActionById  String? // who moved the status (audit)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // One charge per appointment per kind — a session bill and a late fee can
  // coexist; a late fee can never stack twice on the same appointment.
  @@unique([appointmentId, kind])
  @@index([clientId, status])
  @@index([status, dueAt])
}

model SquareCustomerLink {
  id               String  @id @default(cuid())
  clientId         String  @unique
  squareCustomerId String  @unique
  cardOnFile       Boolean @default(false)
}

// Square payments seen by webhook that don't reference one of our charges —
// e.g. taken on her POS/reader — surfaced in the ledger for one-tap matching.
model ExternalPayment {
  id               String    @id @default(cuid())
  squarePaymentId  String    @unique
  squareCustomerId String?
  amountCents      Int
  currency         String    @default("USD")
  status           String // Square status, e.g. COMPLETED
  receivedAt       DateTime  @default(now())
  matchedChargeId  String? // set when matched to a Charge
}

// C9 — Worksheet Studio. The field schema lives as JSON (ordered typed
// fields), so any worksheet shape works with no migrations. Parallels C3's
// Assignment/Response on purpose — C4 unifies them in the record.
model Worksheet {
  id          String                @id @default(cuid())
  title       String
  intro       String?
  schema      Json // ordered array of typed fields (lib/worksheet-meta.ts)
  active      Boolean               @default(true)
  isIntake    Boolean               @default(false) // the practice intake (C11) — at most one
  isSpiral    Boolean               @default(false) // the values-spiral assessment (C12) — at most one
  locale          String            @default("en") // AMD-05 A5 — content language
  translationOfId String? // AMD-05 A5 — sibling locale version; serve by preference, fall back to origin
  createdById String
  sourceNote  String? // where the idea came from (practitioner's own note)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  assignments WorksheetAssignment[]
}

model WorksheetAssignment {
  id           String             @id @default(cuid())
  worksheetId  String
  worksheet    Worksheet          @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  clientId     String
  client       User               @relation("ClientWorksheets", fields: [clientId], references: [id], onDelete: Cascade)
  assignedById String
  status       String             @default("PENDING") // PENDING | COMPLETED | DISMISSED
  dueAt        DateTime?
  fromNoteId   String? // C14 — the practitioner note this grew from
  createdAt    DateTime           @default(now())
  response     WorksheetResponse?

  @@index([clientId, status])
}

model WorksheetResponse {
  id           String              @id @default(cuid())
  assignmentId String              @unique
  assignment   WorksheetAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  answers      Json // { fieldId: value } — structured, keyed to the schema
  completedAt  DateTime            @default(now())
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum LessonType {
  VIDEO
  TEXT
  EXERCISE
}

enum VideoSource {
  YOUTUBE
  VIMEO
  UPLOAD
}

model Course {
  id          String       @id @default(cuid())
  title       String
  description String?
  coverKey    String? // object-storage key (upload deferred)
  status      CourseStatus @default(DRAFT)
  locale          String   @default("en") // AMD-05 A5 — content language
  translationOfId String? // AMD-05 A5 — sibling locale version
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  chapters    Chapter[]
  enrollments Enrollment[]
}

model Chapter {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  summary     String?
  order       Int
  releaseRule String? // NULLABLE now; drip deferred
  lessons     Lesson[]

  @@index([courseId, order])
}

model Lesson {
  id        String     @id @default(cuid())
  chapterId String
  chapter   Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  type      LessonType @default(TEXT)
  // video
  videoSource VideoSource?
  videoUrl    String? // for YOUTUBE/VIMEO embeds
  videoKey    String? // for UPLOAD (deferred)
  // text
  content Json? // {text: string} for now; rich-text upgrade later
  // exercise (reuse existing content)
  promptId    String?
  worksheetId String? // C9 hook; worksheets not built yet

  @@index([chapterId, order])
}

model Enrollment {
  id         String           @id @default(cuid())
  courseId   String
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  clientId   String
  client     User             @relation("ClientEnrollments", fields: [clientId], references: [id], onDelete: Cascade)
  enrolledAt DateTime         @default(now())
  progress   LessonProgress[]

  @@unique([courseId, clientId])
}

model LessonProgress {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  completedAt  DateTime?

  @@unique([enrollmentId, lessonId])
}

// C5 — a stored session-prep formulation. Practitioner-only, doubles as the
// audit record (who/when/client/model/flag). Content never goes to app logs.
model SessionPrep {
  id                String   @id @default(cuid())
  clientId          String
  client            User     @relation("ClientPreps", fields: [clientId], references: [id], onDelete: Cascade)
  requestedById     String // practitioner
  createdAt         DateTime @default(now())
  scopeFrom         DateTime?
  scopeTo           DateTime?
  model             String // model + prompt version (audit)
  referralFlag      Boolean  @default(false)
  output            Json // structured formulation — sensitive, practitioner-only
  practitionerNotes String? // her annotations

  @@index([clientId, createdAt])
}

enum RecordKind {
  LOG_ENTRY
  PROMPT_RESPONSE
  WORKSHEET_RESPONSE
  COURSE_ACTIVITY
  NOTE
  MESSAGE
}

// The unified longitudinal record (C4): every feature appends here through
// lib/record.ts — the single write path. title/summary/mood/tags are
// denormalized snapshots for fast timelines and C5's input; the source row
// (sourceType/sourceId) stays the full-fidelity truth.
model RecordItem {
  id         String     @id @default(cuid())
  clientId   String
  client     User       @relation("ClientRecord", fields: [clientId], references: [id], onDelete: Cascade)
  kind       RecordKind
  occurredAt DateTime // canonical timeline time
  title      String? // short label for the timeline
  summary    String? // short text snapshot
  mood       Int? // normalized mood, if the source had one
  tags       String[] // normalized theme tags
  sourceType String // "LogEntry" | "PromptResponse" | "WorksheetResponse" | "LessonProgress"
  sourceId   String // reference-by-convention to the detail row
  detectedLanguage String? // AMD-05 A2 — optional signal ("en" | "es" | "mixed"); never a gate
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([sourceType, sourceId]) // one record item per source row (idempotent writes)
  @@index([clientId, occurredAt])
  @@index([clientId, kind])
}

enum PromptKind {
  PROMPT
  EXERCISE
  CHECK_IN
}

enum AssignmentStatus {
  PENDING
  COMPLETED
  DISMISSED
}

model Prompt {
  id          String       @id @default(cuid())
  kind        PromptKind   @default(PROMPT)
  title       String
  body        String // the prompt / exercise text
  active      Boolean      @default(true) // archive without deleting
  locale          String   @default("en") // AMD-05 A5 — content language
  translationOfId String? // AMD-05 A5 — sibling locale version
  createdById String // practitioner
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignments Assignment[]
}

model Assignment {
  id           String           @id @default(cuid())
  promptId     String
  prompt       Prompt           @relation(fields: [promptId], references: [id], onDelete: Cascade)
  clientId     String
  client       User             @relation("ClientAssignments", fields: [clientId], references: [id], onDelete: Cascade)
  assignedById String // practitioner
  status       AssignmentStatus @default(PENDING)
  dueAt        DateTime?
  scheduleRule String? // NULLABLE now; recurring cadence deferred (spec §3)
  fromNoteId   String? // C14 — the practitioner note this grew from
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  response     PromptResponse?

  @@index([clientId, status])
}

model PromptResponse {
  id           String     @id @default(cuid())
  assignmentId String     @unique
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  body         String? // reflection text (optional for check-ins)
  mood         Int? // for check-ins / optional
  completedAt  DateTime   @default(now())
}

enum EntryType {
  TRIGGER
  INSIGHT
  PROGRESS
  REFLECTION
}

model LogEntry {
  id         String    @id @default(cuid())
  clientId   String
  client     User      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type       EntryType @default(REFLECTION)
  occurredAt DateTime  @default(now()) // when the moment happened (editable)
  body       String // the core reflection — the ONLY required field
  trigger    String? // what prompted it (optional)
  mood       Int? // 1..5, optional
  tags       String[] // optional; seeds later pattern-mapping (C5)
  createdAt  DateTime  @default(now()) // when it was logged
  updatedAt  DateTime  @updatedAt

  @@index([clientId, occurredAt])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Invite {
  id             String       @id @default(cuid())
  email          String
  name           String?
  tokenHash      String       @unique // store the SHA-256 hash, NEVER the raw token
  status         InviteStatus @default(PENDING)
  expiresAt      DateTime
  invitedById    String // practitioner User id
  acceptedUserId String? // set on acceptance
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([email])
}

// C10 — Scheduling & Sessions. Bookings reveal who is a client and when, so
// everything is PRACTITIONER-gated server-side and clients see only their own.
// Times are stored in UTC; the practitioner's tz lives in SchedulingConfig and
// slot generation is DST-correct (lib/schedule.ts). Everything keys by
// practitionerId so a second practitioner needs no schema change.

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// C18 — sessions belong to clients; discovery calls belong to leads (prospects).
enum AppointmentKind {
  SESSION
  DISCOVERY
}

// C18 — discovery hours are set separately from session hours, so availability
// rules are tagged by which kind of booking they open.
enum AvailabilityKind {
  SESSION
  DISCOVERY
}

// C18 — a prospect's journey: stranger → lead → discovery → invited → client.
enum LeadStatus {
  NEW
  SCHEDULED
  COMPLETED
  CONVERTED
  CLOSED
}

enum SessionLocation {
  VIRTUAL
  IN_PERSON
}

enum ExceptionType {
  BLOCK // a one-off closure inside normal hours
  OPEN // a one-off opening outside normal hours
}

model SchedulingConfig {
  id                String @id @default(cuid())
  practitionerId    String @unique
  timezone          String // IANA, e.g. "America/New_York"
  sessionMinutes    Int    @default(50)
  bufferMinutes     Int    @default(10)
  minNoticeHours    Int    @default(12)
  maxAdvanceDays    Int    @default(60)
  cancelCutoffHours Int    @default(24) // C10-POLICY — the fee boundary (>= cutoff is free)
  lateFeeCents      Int    @default(5000) // C10-POLICY — the $50; hers to change
  lateFeeAutoApply  Boolean @default(true) // C10-POLICY — auto-create the fee, or prompt her each time
  noShowConsumesCredit Boolean @default(false) // C10-POLICY §5 — stricter alternative, shipped off
  discoveryMinutes  Int    @default(20) // C18 — free discovery call length
  discoveryVideoUrl String? // C18 — standing room for discovery calls (falls back to defaultVideoUrl)
  defaultVideoUrl   String? // standing room link used when an appointment has none
  calendarFeedSecret String @unique // unguessable token for the ICS feed (rotatable)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AvailabilityRule {
  id             String           @id @default(cuid())
  practitionerId String
  kind           AvailabilityKind @default(SESSION) // C18 — SESSION or DISCOVERY hours
  weekday        Int // 0-6 (Sunday..Saturday), practitioner tz
  startMinute    Int // minutes from midnight
  endMinute      Int
  active         Boolean          @default(true)

  @@index([practitionerId, weekday])
}

model AvailabilityException {
  id             String        @id @default(cuid())
  practitionerId String
  date           DateTime // the civil date (midnight UTC) this applies to
  type           ExceptionType
  startMinute    Int? // required for OPEN; ignored for full-day BLOCK
  endMinute      Int?
  reason         String?

  @@index([practitionerId, date])
}

model Appointment {
  id             String            @id @default(cuid())
  practitionerId String
  // Nullable because a DISCOVERY appointment belongs to a Lead (a prospect), not
  // a client User (C18). Exactly one of client / lead is set — enforced in the
  // service layer (lib/appointments.ts, lib/discovery.ts).
  clientId       String?
  client         User?             @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)
  kind           AppointmentKind   @default(SESSION)
  lead           Lead?             @relation("LeadAppointment") // set for DISCOVERY (C18)
  startAt        DateTime // UTC
  endAt          DateTime // UTC
  status         AppointmentStatus @default(SCHEDULED)
  location       SessionLocation   @default(VIRTUAL)
  videoProvider  String? // ZOOM | MEET | WHEREBY | DAILY | null
  videoUrl       String? // join link
  videoRoomId    String?
  bookedBy       String // "practitioner" | "client"
  clientNote     String? // optional topic
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([practitionerId, startAt])
  @@index([clientId, startAt])
}

// C18 — a prospect from the public site. Becomes a client via the conversion
// bridge ("Invite as client"), which pre-fills the C1 invite and links back here.
model Lead {
  id              String      @id @default(cuid())
  name            String
  email           String
  phone           String?
  note            String? // "what brings you?"
  status          LeadStatus  @default(NEW)
  appointmentId   String?     @unique // the discovery call
  appointment     Appointment? @relation("LeadAppointment", fields: [appointmentId], references: [id], onDelete: SetNull)
  convertedUserId String? // set when she invites them as a client
  source          String? // page/UTM, for later
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status, createdAt])
}
