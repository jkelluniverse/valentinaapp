generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PRACTITIONER
  CLIENT
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String?
  role         Role       @default(CLIENT)
  active       Boolean    @default(true) // deactivation gate for login
  consentAt    DateTime? // set when a client accepts consent
  entries      LogEntry[]
  assignments  Assignment[] @relation("ClientAssignments")
  record       RecordItem[] @relation("ClientRecord")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

enum RecordKind {
  LOG_ENTRY
  PROMPT_RESPONSE
  WORKSHEET_RESPONSE
  COURSE_ACTIVITY
  NOTE
}

// The unified longitudinal record (C4): every feature appends here through
// lib/record.ts — the single write path. title/summary/mood/tags are
// denormalized snapshots for fast timelines and C5's input; the source row
// (sourceType/sourceId) stays the full-fidelity truth.
model RecordItem {
  id         String     @id @default(cuid())
  clientId   String
  client     User       @relation("ClientRecord", fields: [clientId], references: [id], onDelete: Cascade)
  kind       RecordKind
  occurredAt DateTime // canonical timeline time
  title      String? // short label for the timeline
  summary    String? // short text snapshot
  mood       Int? // normalized mood, if the source had one
  tags       String[] // normalized theme tags
  sourceType String // "LogEntry" | "PromptResponse" | "WorksheetResponse" | "LessonProgress"
  sourceId   String // reference-by-convention to the detail row
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([sourceType, sourceId]) // one record item per source row (idempotent writes)
  @@index([clientId, occurredAt])
  @@index([clientId, kind])
}

enum PromptKind {
  PROMPT
  EXERCISE
  CHECK_IN
}

enum AssignmentStatus {
  PENDING
  COMPLETED
  DISMISSED
}

model Prompt {
  id          String       @id @default(cuid())
  kind        PromptKind   @default(PROMPT)
  title       String
  body        String // the prompt / exercise text
  active      Boolean      @default(true) // archive without deleting
  createdById String // practitioner
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignments Assignment[]
}

model Assignment {
  id           String           @id @default(cuid())
  promptId     String
  prompt       Prompt           @relation(fields: [promptId], references: [id], onDelete: Cascade)
  clientId     String
  client       User             @relation("ClientAssignments", fields: [clientId], references: [id], onDelete: Cascade)
  assignedById String // practitioner
  status       AssignmentStatus @default(PENDING)
  dueAt        DateTime?
  scheduleRule String? // NULLABLE now; recurring cadence deferred (spec §3)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  response     PromptResponse?

  @@index([clientId, status])
}

model PromptResponse {
  id           String     @id @default(cuid())
  assignmentId String     @unique
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  body         String? // reflection text (optional for check-ins)
  mood         Int? // for check-ins / optional
  completedAt  DateTime   @default(now())
}

enum EntryType {
  TRIGGER
  INSIGHT
  PROGRESS
  REFLECTION
}

model LogEntry {
  id         String    @id @default(cuid())
  clientId   String
  client     User      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type       EntryType @default(REFLECTION)
  occurredAt DateTime  @default(now()) // when the moment happened (editable)
  body       String // the core reflection — the ONLY required field
  trigger    String? // what prompted it (optional)
  mood       Int? // 1..5, optional
  tags       String[] // optional; seeds later pattern-mapping (C5)
  createdAt  DateTime  @default(now()) // when it was logged
  updatedAt  DateTime  @updatedAt

  @@index([clientId, occurredAt])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Invite {
  id             String       @id @default(cuid())
  email          String
  name           String?
  tokenHash      String       @unique // store the SHA-256 hash, NEVER the raw token
  status         InviteStatus @default(PENDING)
  expiresAt      DateTime
  invitedById    String // practitioner User id
  acceptedUserId String? // set on acceptance
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([email])
}
