# --- Database (Railway provides this automatically once Postgres is added) ---
DATABASE_URL="postgresql://user:password@host:port/dbname"

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"

# --- Seed account (used once by: npm run db:seed) ---
SEED_PRACTITIONER_EMAIL="valentina@example.com"
SEED_PRACTITIONER_PASSWORD="pick-a-strong-password"

# --- C5 session prep (AI) ---
# Server-side only; the key never reaches the browser.
ANTHROPIC_API_KEY="sk-ant-..."
# Optional: override the model (defaults to claude-opus-4-8).
# ANTHROPIC_MODEL="claude-opus-4-8"
# Data controls: this practice treats client data to a high standard — if your
# Anthropic organization offers zero-retention for API traffic, enable it there
# (it's an org-level setting, not a per-request flag).

# --- C1 invites ---
# The default C1 build uses copyable invite links — no new vars required.
# Optional fast-follow: send invite links automatically by email (Resend).
# Uncomment and set these only if you enable email delivery.
# RESEND_API_KEY="re_..."
# INVITE_FROM_EMAIL="Valentina <hello@yourdomain.com>"

# --- C10 scheduling: booking notification emails (optional) ---
# Bookings, reschedules, and cancellations email the practitioner (and client)
# with an .ics invite. Without these, scheduling still works and the calendar
# feed still syncs — only the emails are skipped.
# RESEND_API_KEY="re_..."
# NOTIFY_FROM_EMAIL="Valentina <sessions@yourdomain.com>"
#
# Optional video (Option A — attach a per-appointment Zoom/Meet link). Until
# these are wired, virtual sessions use the standing room link set on the
# availability page. Server-to-Server OAuth for Zoom:
# ZOOM_ACCOUNT_ID="..."
# ZOOM_CLIENT_ID="..."
# ZOOM_CLIENT_SECRET="..."
#
# Optional embedded in-app video (Option B): WHEREBY_API_KEY or DAILY_API_KEY.
# Optional SMS on booking: TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM.
# Optional Google Calendar two-way sync: GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET.

# --- C11 profile & Human Design ---
# No keys needed: charts are computed fully in-house (astronomy-engine
# ephemeris + in-app HD mechanics), so birth data never leaves the server.
# Birthplace lookup uses Open-Meteo's free geocoder (place name only — no
# key, no identity, no birth date attached).
